<?php
/**
 * カスタム投稿名「Works」（post_type: 'works'）の詳細ページを表示するテンプレートです。
 *
 * @package DESIGN:D
 */
get_header(); ?>

<?php while ( have_posts() ) : the_post(); ?>

	<div class="contents pb0">

		<header class="work__header">
			<div class="work__header__container">
				<h3 class="work__header__title"><span><?php the_title(); ?></span></h3>
			</div>
		</header>

	</div>

	<div class="work__contents">
		<div class="work__container">

<?php the_content(); ?>

		</div>
	</div>

	<div class="contents pt0">

<?php
	$field_value = get_field( 'work_staff' );
	if( $field_value ) {
?>
		<div class="staff">
			<div class="staff__header">
				<h4 class="staff__header__title">Staff</h4>
			</div>
			<div class="staff__container">
				<ul>
<?php
		$field_value = str_replace(["\r\n", "\r", "\n"], "\n", $field_value); //改行の特殊文字をすべてのパターンに対応できるように統一
		$staffs = explode("\n", $field_value); //配列に変換
		$staffs = array_filter($staffs, "strlen"); //空白の配列を削除
		$staffs = array_values($staffs); //連番に振り直す
		foreach ($staffs as $staff) {
			echo '<li>' . $staff . '</li>';
		}
?>
				</ul>
			</div>
		</div>
<?php
	}
?>

<?php endwhile; ?>

	</div>

<?php
	/* カスタムテンプレート「recommend.php」をインクルードします。 */
	get_template_part( 'template-parts/recommend' );
?>

<?php get_footer(); ?>